{
    // Type-checks the project templates in place (npm run typecheck); not part of a generated project.
    // tyvo init writes the generated project's own tsconfig.json (src/cli/templates.ts).
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "paths": {
            "@tyvo/core": ["../src/index.ts"],
            "@tyvo/core/server": ["../src/server/index.ts"],
            "@tyvo/core/router": ["../src/react/router.ts"],
            "@tyvo/core/link": ["../src/react/link.ts"],
            "@tyvo/core/client": ["../src/client.ts"],
            // example/ is copied over base/, so its files win.
            "@/*": ["./example/src/*", "./base/src/*"]
        },
        // "./$types" next to a template file reads the folder types generated into .types/ (as .tyvo/types in a project).
        "rootDirs": [".", "./.types"]
    },
    // tyvo-env.d.ts references these through the package name, which only resolves in a generated project.
    "files": ["../assets.d.ts"],
    // .types/: the route types of base + example, generated by scripts/typecheck-templates.mjs (as tyvo dev would).
    "include": ["base/**/*.ts", "base/**/*.tsx", "example/**/*.ts", "example/**/*.tsx", ".types/**/*.ts"],
    "exclude": ["base/tyvo-env.d.ts"]
}
